# Copy this file to .env.local and paste your DEV Supabase values.
# .env.local is git-ignored and must never be committed.
NEXT_PUBLIC_SUPABASE_URL=your-dev-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-dev-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-dev-service-role-key

# --- Milestone 6: email notifications (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=LodgeIQ <onboarding@resend.dev>

# Protects the daily cron endpoint. Set the same value in Vercel after deploy.
CRON_SECRET=
